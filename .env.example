# Copia este archivo como .env y ajústalo a tu computadora.

# Perfil del modelo (sección 9.2 de la visión):
#   ligero   -> gemma4:e4b  (por defecto; corre en una MacBook de 16 GB)
#   completo -> gemma4:26b  (video demo; PC con 32 GB de RAM)
#   minimo   -> gemma4:e2b  (equipos con 8 GB)
PERFIL_MODELO=ligero
# Opcional: forzar otro modelo distinto al del perfil
# MODELO_LLM=gemma4:e4b
MODELO_EMBEDDINGS=nomic-embed-text
OLLAMA_URL=http://localhost:11434

# 1 = no usa Ollama: los agentes usan sus reglas de respaldo (útil para trabajar la interfaz)
USAR_LLM_FALSO=0

RUTA_DB=datos/rescate.duckdb
